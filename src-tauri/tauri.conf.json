{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Authenticator",
  "version": "1.0.0",
  "identifier": "com.authenticator.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Authenticator",
        "width": 460,
        "height": 780,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
